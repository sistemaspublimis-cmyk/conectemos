# SQLite local (por defecto). Para PostgreSQL:
# DATABASE_URL="postgresql://conectemos:conectemos@localhost:5432/conectemos?schema=public"
DATABASE_URL="file:./dev.db"

# Secreto de sesión (cambiar en producción)
AUTH_SECRET="cambia-este-secreto-largo-en-produccion"

# App
NEXT_PUBLIC_APP_NAME="Conectemos"
APP_URL="http://localhost:3110"

# Gmail — integración preparada. Si no se configuran, los correos quedan en estado PREPARADO.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GMAIL_FROM="Conectemos <noreply@localhost>"

# WhatsApp Business Cloud API — integración preparada.
# Si no se configuran, el panel muestra "WhatsApp no conectado".
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# Almacenamiento local (producción: configurar disco persistente o S3 compatible)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="10"
